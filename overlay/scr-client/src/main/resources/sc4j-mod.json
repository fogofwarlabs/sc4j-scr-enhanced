{
  "format": 1,
  "id": "scr-enhanced",
  "name": {"en": "SC:R Enhanced", "ko": "SC:R Enhanced"},
  "entry": "org.fogofwarlabs.sc4j.scr.ScrMod",
  "description": {
    "en": "SC:R mod with convenience and extension features. Requires StarCraft: Remastered.",
    "ko": "편의 기능과 확장 기능을 더한 SC:R 모드. 스타크래프트: 리마스터 설치 필요."
  },
  "authors": ["Fog of War Labs"],
  "notices": [
    {
      "en": "SC4J is not affiliated with or endorsed by Blizzard Entertainment. StarCraft is a trademark of Blizzard Entertainment, Inc.",
      "ko": "SC4J는 Blizzard Entertainment와 제휴하거나 승인받지 않았습니다. StarCraft는 Blizzard Entertainment, Inc.의 상표입니다."
    },
    {"en": "The mod contains no Blizzard assets.", "ko": "모드에는 Blizzard 에셋이 없습니다."}
  ],
  "website": "https://github.com/fogofwarlabs/sc4j",
  "images": {"icon": "meta/icon.png", "banner": "meta/banner.png"},
  "tools": [{"id": "script", "main": "org.fogofwarlabs.sc4j.screnhanced.script.ScriptTool"}],
  "settings": [
    {
      "key": "gameFolder",
      "type": "directory",
      "required": true,
      "label": {"en": "StarCraft: Remastered folder", "ko": "스타크래프트: 리마스터 폴더"},
      "description": {
        "en": "The folder where StarCraft: Remastered is installed",
        "ko": "스타크래프트: 리마스터가 설치된 폴더"
      },
      "check": {"contains": [".build.info"], "containsAny": ["x86_64/StarCraft.exe", "x86_64/StarCraft.app/Contents/MacOS/StarCraft"]},
      "message": {
        "en": "Not a StarCraft: Remastered folder",
        "ko": "스타크래프트: 리마스터 폴더가 아님"
      },
      "detect": {"uninstallEntries": ["StarCraft"], "programFolders": ["StarCraft"]},
      "shared": "starcraft-remastered"
    },
    {
      "key": "locale",
      "type": "choice",
      "options": ["enUS", "deDE", "esES", "esMX", "frFR", "itIT", "jaJP", "koKR", "plPL", "ptBR", "ruRU", "zhCN", "zhTW"],
      "default": "enUS",
      "systemDefault": true,
      "label": {"en": "Text language", "ko": "텍스트 언어"}
    }
  ]
}
